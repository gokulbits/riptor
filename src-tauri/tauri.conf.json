{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riptor",
  "version": "0.1.6",
  "identifier": "app.riptor.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Riptor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      },
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDRTE3NDRFMDE5MzdCM0UKUldRK2U1TUJUblRoTEdBcmlEOGdQb3ZKQ2kwU2F6WU5vSjh3Z1RLODdoNXZYYXoxNy9GdllMWXYK",
      "endpoints": ["https://github.com/gokulbits/riptor/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "publisher": "gokulbits",
    "shortDescription": "Lightweight BitTorrent client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "description": "BitTorrent metainfo file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "openvpn",
          "pkexec | policykit-1",
          "python3",
          "bubblewrap"
        ],
        "desktopTemplate": "linux/riptor.desktop",
        "files": {
          "/usr/share/polkit-1/actions/app.riptor.vpn-helper.policy": "linux/app.riptor.vpn-helper.policy",
          "/usr/lib/systemd/user/riptord.service": "linux/riptord.service"
        }
      },
      "rpm": {
        "depends": [
          "openvpn",
          "polkit",
          "python3",
          "bubblewrap"
        ],
        "desktopTemplate": "linux/riptor.desktop",
        "files": {
          "/usr/share/polkit-1/actions/app.riptor.vpn-helper.policy": "linux/app.riptor.vpn-helper.policy",
          "/usr/lib/systemd/user/riptord.service": "linux/riptord.service"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
